# OmniSix Live Call Server — Environment Variables
# Copy this to .env and fill in your values

# Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Cloud API (Meta Developer Portal)
WHATSAPP_TOKEN=your_whatsapp_cloud_api_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Server public URL (no trailing slash)
# Local: http://localhost:3000
# Railway: https://your-app.up.railway.app
# Render: https://your-app.onrender.com
CALL_SERVER_URL=https://your-domain.com

# Server port (Railway sets this automatically)
PORT=3000
